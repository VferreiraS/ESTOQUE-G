{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "firestore.rules", "firestore.indexes.json", "**/.*", "**/node_modules/**", "CLAUDE.md", "README.md", "apps-script/**"],
    "headers": [
      {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/robo.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "firestore": {"rules": "firestore.rules", "indexes": "firestore.indexes.json"},
  "auth": {"providers": {"emailPassword": true}}
}
