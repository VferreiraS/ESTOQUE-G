rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Perfis da loja: o caminho (id da loja) só é conhecido por quem está na equipe.
    match /lojas/{loja}/perfis/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['login','role','p','at']);
    }
  }
}
